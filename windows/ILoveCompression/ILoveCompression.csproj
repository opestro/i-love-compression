<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ILoveCompression</RootNamespace>
    <AssemblyName>ILoveCompression</AssemblyName>
    <ApplicationIcon>..\..\assets\AppIcon.ico</ApplicationIcon>
    <Product>I Love Compression</Product>
    <Version>0.1.1</Version>
    <!-- ThemeMode (the Windows 11 Fluent look) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon-256.png" Link="icon-256.png" />
  </ItemGroup>

</Project>
